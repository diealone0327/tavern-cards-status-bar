{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "系统": {
      "type": "object",
      "properties": {
        "当前时间": {
          "default": "傍晚",
          "type": "string"
        },
        "当前场景": {
          "default": "柳家别墅客厅",
          "type": "string"
        },
        "最近事件": {
          "default": "婚礼结束，正式入住柳家",
          "type": "string"
        }
      }
    },
    "柳清禾": {
      "type": "object",
      "properties": {
        "好感度": {
          "default": 10,
          "type": "number"
        },
        "近期态度": {
          "default": "冷淡疏离，把合约丈夫当空气",
          "type": "string"
        }
      }
    },
    "柳知晚": {
      "type": "object",
      "properties": {
        "好感度": {
          "default": 5,
          "type": "number"
        },
        "近期态度": {
          "default": "完全不认可这个突然出现的妹夫",
          "type": "string"
        }
      }
    },
    "柳书瑶": {
      "type": "object",
      "properties": {
        "好感度": {
          "default": 20,
          "type": "number"
        },
        "近期态度": {
          "default": "对新姐夫充满好奇和好感",
          "type": "string"
        }
      }
    },
    "柳语茉": {
      "type": "object",
      "properties": {
        "好感度": {
          "default": 15,
          "type": "number"
        },
        "近期态度": {
          "default": "礼貌观察中，正在评估这个合约女婿",
          "type": "string"
        }
      }
    }
  },
  "required": [
    "系统",
    "柳清禾",
    "柳知晚",
    "柳书瑶",
    "柳语茉"
  ]
}