    "世界": {
      "default": {},
      "type": "object",
      "properties": {
        "日期": {
          "default": "",
          "type": "string",
          "description": "格式 YYYY/MM/DD，如 2026/08/24；不做格式强校验，仅作时间连续性参考"
        },
        "时间段": {
          "default": "上午",
          "type": "string",
          "enum": [
            "清晨",
            "上午",
            "中午",
            "下午",
            "傍晚",
            "夜晚",
            "深夜"
          ]
        },
        "当前位置": {
          "default": "",
          "type": "string",
          "description": "当前场景，如 <user>家 / 林家住宅 / 公司 / 咖啡馆"
        }
      }
    },
    "主线": {
      "default": {},
      "type": "object",
      "properties": {
        "阶段": {
          "default": "发现",
          "type": "string",
